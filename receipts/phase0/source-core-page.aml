program Core {
 state { count: int frames: map[string]bytes }
 constructor() { self.count = 0 }
 public fn append(frame: bytes): int {
  require(len(frame) == 2048, "frame size")
  require(self.count < 1024, "full")
  let sequence = self.count
  self.frames[to_string(sequence)] = frame
  self.count = sequence + 1
  return sequence
 }
 public view fn get(sequence: int): bytes {
  require(sequence >= 0 && sequence < self.count, "range")
  return self.frames[to_string(sequence)]
 }
 public view fn page(start: int, max_records: int): bytes {
  require(start >= 0 && start < self.count, "empty")
  require(max_records > 0 && max_records <= 64, "limit")
  require(start + max_records <= self.count, "range")
  let finish = start + max_records
  let output = self.frames[to_string(start)]
  let next = start + 1
  for index in next..finish { output = concat(output, self.frames[to_string(index)]) }
  return output
 }
}