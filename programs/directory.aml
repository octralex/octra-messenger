program MailboxDirectory {
  state {
    segments: map[address]address
    registered: map[address]bool
  }

  event Registered(owner: address)

  public fn register(segment: address) {
    self.segments[caller] = segment
    self.registered[caller] = true
    emit Registered(caller)
  }

  public view fn has(owner: address): bool {
    return self.registered[owner]
  }

  public view fn segment_of(owner: address): address {
    require(self.registered[owner], "owner not registered")
    return self.segments[owner]
  }
}
