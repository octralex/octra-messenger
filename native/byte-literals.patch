diff --git a/lib/vm/compiler/oct_lex.ml b/lib/vm/compiler/oct_lex.ml
index a47fa98..ab8ed8b 100644
--- a/lib/vm/compiler/oct_lex.ml
+++ b/lib/vm/compiler/oct_lex.ml
@@ -89,6 +89,19 @@ let skip_block_comment lx =
     | _ -> advance lx; go depth
   in go 1
 
+let hex_escape lx =
+  advance lx;
+  let digit () =
+    match peek lx with
+    | Some ('0' .. '9' as value) -> advance lx; Char.code value - Char.code '0'
+    | Some ('a' .. 'f' as value) -> advance lx; Char.code value - Char.code 'a' + 10
+    | Some ('A' .. 'F' as value) -> advance lx; Char.code value - Char.code 'A' + 10
+    | _ -> err lx "invalid hex escape"
+  in
+  let high = digit () in
+  let low = digit () in
+  Char.chr ((high lsl 4) lor low)
+
 let read_string lx =
   advance lx;
   let buf = Buffer.create 32 in
@@ -103,6 +116,7 @@ let read_string lx =
        | Some 't' -> Buffer.add_char buf '\t'; advance lx; go ()
        | Some '\\' -> Buffer.add_char buf '\\'; advance lx; go ()
        | Some '"' -> Buffer.add_char buf '"'; advance lx; go ()
+       | Some 'x' -> Buffer.add_char buf (hex_escape lx); go ()
        | _ -> err lx "invalid escape")
     | Some '\000' -> err lx "NUL byte is not allowed in string"
     | Some c -> Buffer.add_char buf c; advance lx; go ()
